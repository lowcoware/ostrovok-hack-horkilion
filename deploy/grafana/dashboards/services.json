{
  "uid": "horkilion-services",
  "title": "Horkilion: сервисы",
  "description": "Здоровье Go-сервисов: HTTP gateway, gRPC между сервисами, рантайм Go.",
  "tags": [
    "horkilion"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
