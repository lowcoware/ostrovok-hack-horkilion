      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (rate(http_requests_total{code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
