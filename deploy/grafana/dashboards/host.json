{
  "uid": "horkilion-host",
  "title": "Horkilion: сервер и контейнеры",
  "description": "Ресурсы сервера (node-exporter) и потребление каждого контейнера (cAdvisor).",
  "tags": [
    "horkilion"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Дашборды проекта",
