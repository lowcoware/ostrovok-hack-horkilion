    {
      "type": "bargauge",
      "title": "Сколько сессий дошли до шага",
      "description": "windowFunnel за 7 дней: шаги должны идти по порядку в одной сессии.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT\n    countIf(level >= 1) AS `1. Начали разговор`,\n    countIf(level >= 2) AS `2. Увидели отели`,\n    countIf(level >= 3) AS `3. Выбрали вариант`,\n    countIf(level >= 4) AS `4. Оплатили`\nFROM\n(\n    SELECT session_id, windowFunnel(604800)(\n        toDateTime(event_time),\n        event = 'session_started',\n        event = 'stage_entered' AND stage IN ('compare', 'assemble'),\n        event = 'option_selected',\n        event = 'checkout_completed'\n    ) AS level\n    FROM analytics.events\n    WHERE $__timeFilter(event_time)\n    GROUP BY session_id\n)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "continuous-BlYlRd"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto"
      },
      "id": 9,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "stat",
      "title": "Конверсия в покупку",
      "description": "Доля начатых сессий, которые дошли до оплаты.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
