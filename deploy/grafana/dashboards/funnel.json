          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT event_time AS `время`, JSONExtractString(props, 'order_id') AS `заказ`, JSONExtractInt(props, 'total_rub') AS `сумма, ₽`, JSONExtractInt(props, 'items') AS `позиций`, if(JSONExtractBool(props, 'full_trip'), 'да', 'нет') AS `поездка целиком` FROM analytics.events WHERE event = 'checkout_completed' AND $__timeFilter(event_time) ORDER BY event_time DESC LIMIT 50",
