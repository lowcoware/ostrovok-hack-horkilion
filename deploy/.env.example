# Copy to deploy/.env on the server and fill in, or let ./run.sh generate it.
# Generate secrets with:
#   openssl rand -hex 24
# Use hex secrets: they go into connection URLs unescaped.

# Empty starts the application only (services, frontend, PostgreSQL, NATS).
# "full" adds Langfuse, ClickHouse, Prometheus and Grafana; the server runs full.
COMPOSE_PROFILES=full
# Funnel analytics in ClickHouse. Empty disables them, as without the full profile.
ANALYTICS_URL=http://clickhouse:8123

# Images. CI deploys Go services, the frontend and the docs site under separate tags (the
# commit SHA of their last change) and keeps them in .image-tags on the server.
IMAGE_REGISTRY=ghcr.io/your-github-owner
BACKEND_TAG=latest
WEB_TAG=latest
DOCS_TAG=latest

# Public addresses. Domains give automatic HTTPS, ports give plain HTTP.
SITE_ADDRESS=:80
API_ADDRESS=:8080
LANGFUSE_ADDRESS=:3000
GRAFANA_ADDRESS=:3001
# The public URL of Langfuse, used for its login links.
LANGFUSE_URL=http://localhost:3000

# LLM: any OpenAI-compatible endpoint. Without a key the agent runs on rules
# and template replies. OPENROUTER_API_KEY still works as the key name.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_ROUTER_MODEL=qwen/qwen3.8-27b
# JSON merged into every request; empty means {"provider":{"data_collection":"deny"}}.
LLM_EXTRA_BODY=

# Supplier providers, see cmd/inventory. An unknown value stops the service.
CATALOG_PROVIDER=open-data
LODGING_PROVIDER=osm
TRANSPORT_PROVIDER=synthetic
TRANSFER_PROVIDER=synthetic

# Secrets.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Exactly 64 hex characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=

# Langfuse creates this organization, project, API keys and admin on start.
# The agent sends its traces with the same keys; leave the keys empty to disable tracing.
LANGFUSE_INIT_ORG_ID=horkilion
LANGFUSE_INIT_ORG_NAME=Horkilion
LANGFUSE_INIT_PROJECT_ID=horkilion
LANGFUSE_INIT_PROJECT_NAME=agent
# pk-lf-<openssl rand -hex 16> and sk-lf-<openssl rand -hex 16>
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
# Login for the Langfuse UI.
LANGFUSE_INIT_USER_EMAIL=admin@horkilion.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=
