# Copy to deploy/.env on the server and fill in. Generate secrets with:
#   openssl rand -hex 24
# Use hex secrets: they go into connection URLs unescaped.

# Images. CI deploys with IMAGE_TAG set to the commit SHA.
IMAGE_REGISTRY=ghcr.io/your-github-owner
IMAGE_TAG=latest

# Public addresses. Domains give automatic HTTPS, ports give plain HTTP.
SITE_ADDRESS=:80
LANGFUSE_ADDRESS=:3000
GRAFANA_ADDRESS=:3001
# The public URL of Langfuse, used for its login links.
LANGFUSE_URL=http://localhost:3000

# LLM. Without a key the agent runs on rules and template replies.
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_ROUTER_MODEL=qwen/qwen3.8-27b

# Secrets.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Exactly 64 hex characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=

# Langfuse creates this organization, project, API keys and admin on start.
# The agent sends its traces with the same keys; leave the keys empty to disable tracing.
LANGFUSE_INIT_ORG_ID=horkilion
LANGFUSE_INIT_ORG_NAME=Horkilion
LANGFUSE_INIT_PROJECT_ID=horkilion
LANGFUSE_INIT_PROJECT_NAME=agent
# pk-lf-<openssl rand -hex 16> and sk-lf-<openssl rand -hex 16>
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
# Login for the Langfuse UI.
LANGFUSE_INIT_USER_EMAIL=admin@horkilion.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=
